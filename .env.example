# LinkVault environment variables. Copy to .env for local development:
#   cp .env.example .env
# The API reads ../../.env when started with `npm run dev`; docker compose sets its own values.
# Never commit real secrets.

# ─── API (apps/api) ────────────────────────────────────────────────────────────
# development | test | production. Production requires JWT_SECRET.
NODE_ENV=development
# Port the API listens on (Render injects its own PORT).
PORT=4000
# Interface to bind.
HOST=0.0.0.0
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Set to true behind a reverse proxy (Render) so rate limits see the real client IP.
TRUST_PROXY=false

# Secret used to sign session tokens (HS256). At least 32 characters; generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=
# Session lifetime for normal accounts (demo tokens expire with their sandbox).
JWT_TTL=7d

# Comma-separated web origins allowed to call the API (no trailing slash).
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:8080
# Allow chrome-extension:// origins (the extension uses bearer tokens, no cookies).
ALLOW_EXTENSION_ORIGINS=true

# opensearch | memory. Defaults to opensearch when OPENSEARCH_URL is set, otherwise memory
# (in-process mock store: nothing persists across restarts — fine for trying things out).
SEARCH_BACKEND=
# OpenSearch URL including credentials, e.g. Bonsai: https://user:pass@xxxx.bonsaisearch.net
# Local (docker compose up opensearch): http://localhost:9200
OPENSEARCH_URL=
# Prefix for index names (<prefix>-users, <prefix>-collections, <prefix>-bookmarks).
OPENSEARCH_INDEX_PREFIX=linkvault
# Replicas per index (0 for single-node clusters).
OPENSEARCH_REPLICAS=0

# Page fetcher. NEVER enable ALLOW_PRIVATE_FETCH in production: it disables the SSRF guard
# so localhost/private networks can be fetched (used by the e2e test's local fixture server).
ALLOW_PRIVATE_FETCH=false
FETCH_TIMEOUT_MS=10000
FETCH_MAX_BYTES=5000000
# Parallel extraction jobs.
INGEST_CONCURRENCY=2

# "Try the demo" sandboxes: enabled flag and lifetime in hours.
DEMO_ENABLED=true
DEMO_TTL_HOURS=24
# Seed a fixed local account on boot: demo@linkvault.local / linkvault-demo (dev only).
SEED_LOCAL_DEMO_ACCOUNT=false

# ─── Web app (apps/web, read at build time by Vite) ────────────────────────────
# Base URL of the API. On Netlify set this in Site configuration → Environment variables.
VITE_API_URL=http://localhost:4000
# Where "Download extension" points (defaults to the repo's latest GitHub Release).
VITE_EXTENSION_DOWNLOAD_URL=

# ─── Extension (apps/extension, read at build time by Vite) ────────────────────
# Defaults baked into the extension (users can change them in its options page).
# Release builds default to the production URLs when these are empty.
VITE_WEB_URL=http://localhost:5173
# Extra web app origins the "Connect extension" content script runs on (comma-separated).
VITE_EXTRA_WEB_ORIGINS=

# ─── Tests ─────────────────────────────────────────────────────────────────────
# When set, the store contract tests also run against this OpenSearch (CI uses a service container).
OPENSEARCH_TEST_URL=
# When set, the Playwright e2e run uses OpenSearch instead of the in-memory store.
E2E_OPENSEARCH_URL=
