{
  "name": "@linkvault/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LinkVault API: auth, bookmarks, collections, Readability extraction and OpenSearch full-text search.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "seed": "tsx --env-file-if-exists=../../.env src/scripts/seed.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@linkvault/shared": "*",
    "@mozilla/readability": "^0.6.0",
    "@opensearch-project/opensearch": "^3.5.0",
    "bcryptjs": "^3.0.2",
    "dompurify": "^3.3.0",
    "fastify": "^5.6.0",
    "ipaddr.js": "^2.2.0",
    "jose": "^6.1.0",
    "jsdom": "^28.1.0",
    "undici": "^7.16.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/jsdom": "^27.0.0",
    "pino-pretty": "^13.1.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0"
  }
}
