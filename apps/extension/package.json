{
  "name": "@linkvault/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LinkVault Chrome extension (Manifest V3): save the current tab with one click.",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build",
    "zip": "npm run build && node scripts/zip.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@linkvault/shared": "*",
    "lucide-react": "^1.50.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/chrome": "^0.1.30",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "fflate": "^0.8.2",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4.1.0",
    "vite": "^7.3.7"
  }
}
